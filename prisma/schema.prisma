generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum WorkspaceRole {
  DIRECTOR
  ACCOUNTANT
  EMPLOYEE
}

enum PersonType {
  DIRECTOR
  ACCOUNTANT
  EMPLOYEE
  CONTRACTOR
  CLIENT_CONTACT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum GstTreatment {
  GST_INCLUDED
  GST_FREE
  NO_GST_OVERSEAS
  MANUAL_OVERRIDE
}

enum BasTreatment {
  GST_COLLECTED
  GST_PAID
  PAYROLL
  NONE
}

enum BasFrequency {
  QUARTERLY
  MONTHLY
}

enum BasFilingStatus {
  DRAFT
  FINALIZED
}

enum BasFilingBasis {
  NOT_CONFIGURED
  CASH
  ACCRUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum MembershipRole {
  ADMIN
  EDITOR
  ACCOUNTANT
  VIEWER
}

enum PayrollBasis {
  SALARY
  HOURLY
}

enum PayRunStatus {
  DRAFT
  READY_FOR_REVIEW
  FINALIZED
  CORRECTED
  REVERSED
}

enum PayrollLineItemKind {
  SALARY
  HOURLY
  ALLOWANCE
  REIMBURSEMENT
  DEDUCTION
}

enum PayrollSubmissionType {
  STP_PAY_EVENT
  STP_FINALISATION
  STP_UPDATE
  SUPER_EXPORT
}

enum PayrollSubmissionStatus {
  DRAFT
  VALIDATED
  QUEUED
  SENT
  ACCEPTED
  REJECTED
}

model Workspace {
  id                      String        @id @default(cuid())
  name                    String
  legalName               String?
  abn                     String?       @unique
  address                 String?
  contactEmail            String?
  gstRegistered           Boolean?
  basFrequency            BasFrequency?
  financialYearStartMonth Int?
  invoicePrefix           String?
  quarterLocked           Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  bankAccounts BankAccount[]
  categories   Category[]
  people       Person[]
  expenses     Expense[]
  clients      Client[]
  invoices     Invoice[]
  payRuns      PayRun[]
  memberships  Membership[]
  invitations  Invitation[]
  comments     Comment[]
  payrollSubmissions PayrollSubmission[]
  payrollAuditEvents PayrollAuditEvent[]
  basFilings   BasFiling[]
}

model User {
  id                  String       @id
  authProvider        String
  authProviderUserId  String
  name                String
  email               String
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  memberships  Membership[]
  invitations  Invitation[] @relation("InvitationCreatedBy")
  comments     Comment[]
  payrollAuditEventsCreated PayrollAuditEvent[]
  basFilingsCreated BasFiling[] @relation("BasFilingCreatedBy")
  basFilingsFinalized BasFiling[] @relation("BasFilingFinalizedBy")

  @@unique([authProvider, authProviderUserId])
  @@index([email])
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(EDITOR)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model Invitation {
  id              String         @id @default(cuid())
  workspaceId     String
  email           String
  role            MembershipRole @default(EDITOR)
  tokenHash       String         @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  createdByUserId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([createdByUserId])
}

model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  authorUserId String
  targetType  String
  targetId    String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([authorUserId])
  @@index([targetType, targetId])
}

model BankAccount {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  bank        String
  label       String
  ownerLabel  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@index([workspaceId])
}

model Category {
  id                  String       @id @default(cuid())
  workspaceId         String
  name                String
  type                CategoryType
  defaultGstTreatment GstTreatment
  basTreatment        BasTreatment
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses            Expense[]

  @@index([workspaceId])
}

model Person {
  id                        String         @id @default(cuid())
  workspaceId               String
  name                      String
  email                     String?
  personType                PersonType
  workspaceRole             WorkspaceRole
  payrollEnabled            Boolean        @default(false)
  payrollBasis              PayrollBasis?
  hourlyRateCents           Int?
  salaryPerPayPeriodCents   Int?
  ordinaryHoursPerPayPeriod Float?
  superRateBps              Int            @default(1100)
  tfnLast4                  String?
  employmentStartDate       DateTime?
  employmentEndDate         DateTime?
  bankAccountName           String?
  bankAccountBsb            String?
  bankAccountNumber         String?
  notes                     String?
  active                    Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  workspace                 Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices                  Invoice[]
  payRuns                   PayRun[]
  payrollAuditEvents        PayrollAuditEvent[]

  @@index([workspaceId])
}

model Client {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  email          String?
  abn            String?
  billingAddress String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Invoice {
  id                  String        @id @default(cuid())
  workspaceId         String
  clientId            String
  personId            String?
  invoiceNumber       String
  issueDate           DateTime
  dueDate             DateTime?
  status              InvoiceStatus @default(DRAFT)
  grossCents          Int
  gstTreatment        GstTreatment
  userEnteredGstCents Int?
  paymentDate         DateTime?
  evidenceUrl         String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([clientId])
  @@index([personId])
  @@index([issueDate])
}

model Expense {
  id                  String       @id @default(cuid())
  workspaceId         String
  date                DateTime
  supplier            String?
  categoryId          String
  bankAccountId       String
  grossCents          Int
  gstTreatment        GstTreatment
  userEnteredGstCents Int?
  receiptUrl          String?
  notes               String?
  overrideReason      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([categoryId])
  @@index([bankAccountId])
  @@index([date])
}

model PayRun {
  id                   String             @id @default(cuid())
  workspaceId          String
  personId             String?
  employeeName         String
  periodStart          DateTime
  periodEnd            DateTime
  payDate              DateTime
  grossCents           Int
  reimbursementsCents  Int                @default(0)
  paygCents            Int
  superCents           Int
  finalized            Boolean            @default(false)
  status               PayRunStatus       @default(DRAFT)
  submissionStatus    PayrollSubmissionStatus @default(DRAFT)
  submissionReference String?
  correctsPayRunId    String?
  reversedByPayRunId  String?
  overrideReason       String?
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  lineItems PayrollLineItem[]
  submissions PayrollSubmission[]
  auditEvents PayrollAuditEvent[]

  @@index([workspaceId])
  @@index([personId])
  @@index([periodStart])
  @@index([payDate])
}

model PayrollLineItem {
  id           String              @id @default(cuid())
  payRunId     String
  kind         PayrollLineItemKind
  description  String
  quantityHours Float?
  rateCents    Int?
  amountCents  Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  payRun PayRun @relation(fields: [payRunId], references: [id], onDelete: Cascade)

  @@index([payRunId])
}

model PayrollSubmission {
  id              String                @id @default(cuid())
  workspaceId     String
  payRunId        String?
  type            PayrollSubmissionType
  status          PayrollSubmissionStatus @default(DRAFT)
  payloadJson     Json
  responseJson    Json?
  errorMessage    String?
  externalReference String?
  submittedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payRun    PayRun?   @relation(fields: [payRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([payRunId])
  @@index([status])
}

model PayrollAuditEvent {
  id              String    @id @default(cuid())
  workspaceId     String
  payRunId        String?
  personId        String?
  action          String
  detail          String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payRun    PayRun?   @relation(fields: [payRunId], references: [id], onDelete: SetNull)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([payRunId])
  @@index([personId])
  @@index([createdByUserId])
}

model BasFiling {
  id                String          @id @default(cuid())
  workspaceId       String
  quarterId         String
  quarterLabel      String
  status            BasFilingStatus @default(DRAFT)
  basis             BasFilingBasis  @default(NOT_CONFIGURED)
  reportJson        Json
  sourceHash        String
  lockedAt          DateTime?
  finalizedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdByUserId   String?
  finalizedByUserId String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("BasFilingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy User?     @relation("BasFilingFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, quarterId])
  @@index([workspaceId])
  @@index([quarterId])
}
